@{ViewData["Title"] = "Verify Scenario";}
@{
    var results = ViewBag.Results as List<(string Step, bool Pass, string Expected, string Actual)> ?? new();
}
<h2>🧪 Verify Business Logic Scenario</h2>
<p class="text-muted">This runs the demo scenario in a rolled-back transaction. DB is not modified.</p>

<div class="table-responsive">
<table class="table table-sm">
    <thead class="table-dark"><tr><th>Step</th><th>Result</th><th>Expected</th><th>Actual</th></tr></thead>
    <tbody>
    @foreach (var r in results)
    {
        <tr class="@(r.Pass ? "table-success" : "table-danger")">
            <td>@r.Step</td>
            <td>@(r.Pass ? "✅ PASS" : "❌ FAIL")</td>
            <td>@r.Expected</td>
            <td>@r.Actual</td>
        </tr>
    }
    </tbody>
</table>
</div>

<div class="mt-3">
    @{var allPass = results.All(r => r.Pass);}
    @if (allPass && results.Any())
    { <div class="alert alert-success">🎉 All checks passed!</div> }
    else if (results.Any())
    { <div class="alert alert-danger">Some checks failed. Review the scenario logic.</div> }
</div>

<a asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary">← Dashboard</a>
