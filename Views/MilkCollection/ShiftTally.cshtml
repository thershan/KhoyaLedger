@{ViewData["Title"] = "Shift Tally"; var date = ViewBag.Date as DateOnly?; var shift = ViewBag.Shift as KhoyaLedger.Models.Shift?;}
<h2>📏 Shift Tally</h2>
<div class="row"><div class="col-md-5">
<div class="alert alert-info">
    <strong>Entries Sum:</strong> @(((decimal)ViewBag.SumFromEntries).ToString("F2")) L
    <br/><strong>Date:</strong> @date | <strong>Shift:</strong> @shift
</div>
<form asp-action="ShiftTally" method="post">
    <input type="hidden" name="date" value="@date?.ToString("yyyy-MM-dd")" />
    <input type="hidden" name="shift" value="@((int?)shift ?? 1)" />
    <div class="mb-3"><label class="form-label fw-bold">Measured Litres (from bulk tank)</label><input type="number" name="measuredLitres" step="0.1" class="form-control form-control-lg" /></div>
    <div class="mb-3"><label class="form-label">Notes</label><input type="text" name="notes" class="form-control" /></div>
    <button type="submit" class="btn btn-primary">Save Tally</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
</form>
</div></div>
