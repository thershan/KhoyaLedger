@model KhoyaLedger.Models.ProductionBatch
@{ViewData["Title"] = "Edit Batch";}
<h2>Edit Batch @Model.BatchNumber</h2>
<div class="row"><div class="col-md-7">
<form asp-action="Edit" method="post">
    <input asp-for="Id" type="hidden" /><input asp-for="BatchNumber" type="hidden" /><input asp-for="Status" type="hidden" />
    <div class="row g-2 mb-3">
        <div class="col-6"><label asp-for="BatchDate" class="form-label"></label><input asp-for="BatchDate" type="date" class="form-control" /></div>
    </div>
    <div class="row g-2 mb-3">
        <div class="col-6"><label asp-for="MilkUsedLitres" class="form-label">Milk Used (L)</label><input asp-for="MilkUsedLitres" type="number" step="0.1" class="form-control" /></div>
        <div class="col-6"><label asp-for="KhoyaProducedKg" class="form-label">Khoya Produced (kg)</label><input asp-for="KhoyaProducedKg" type="number" step="0.01" class="form-control" /></div>
    </div>
    <h6>Costs (₹)</h6>
    <div class="row g-2 mb-3">
        <div class="col-6"><label asp-for="WoodCostRs" class="form-label">Wood</label><input asp-for="WoodCostRs" type="number" step="0.01" class="form-control" /></div>
        <div class="col-6"><label asp-for="LabourCostRs" class="form-label">Labour</label><input asp-for="LabourCostRs" type="number" step="0.01" class="form-control" /></div>
        <div class="col-6"><label asp-for="TransportCostRs" class="form-label">Transport</label><input asp-for="TransportCostRs" type="number" step="0.01" class="form-control" /></div>
        <div class="col-6"><label asp-for="OtherCostRs" class="form-label">Other</label><input asp-for="OtherCostRs" type="number" step="0.01" class="form-control" /></div>
    </div>
    <div class="mb-3"><label asp-for="Notes" class="form-label">Notes</label><input asp-for="Notes" class="form-control" /></div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
</form>
</div></div>
