@model List<KhoyaLedger.Models.Customer>
@{ViewData["Title"] = "Customers";}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>🛒 Customers</h2>
    @if (User.IsInRole("Owner")) { <a asp-action="Create" class="btn btn-success">➕ Add Customer</a> }
</div>
<div class="table-responsive">
<table class="table table-hover table-sm">
    <thead class="table-dark"><tr><th>Name</th><th>Mobile</th><th>Address</th><th>Opening Receivable</th><th>Actions</th></tr></thead>
    <tbody>
    @foreach (var c in Model)
    {
        <tr>
            <td>@c.Name</td>
            <td>@c.Mobile</td>
            <td>@c.Address</td>
            <td>₹@c.OpeningReceivable.ToString("N2")</td>
            <td>
                <a asp-action="Statement" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">Statement</a>
                @if (User.IsInRole("Owner")) { <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary">Edit</a> }
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
