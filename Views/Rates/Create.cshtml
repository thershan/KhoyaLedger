@model KhoyaLedger.Models.MilkRateSlab
@{ViewData["Title"] = "Add Rate Slab";}
<h2>Add Rate Slab</h2>
<div class="row"><div class="col-md-6">
<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="alert alert-danger"></div>
    <div class="mb-3"><label asp-for="MilkType" class="form-label"></label><select asp-for="MilkType" asp-items="Html.GetEnumSelectList<KhoyaLedger.Models.MilkType>()" class="form-select"></select></div>
    <div class="form-check mb-3"><input asp-for="IsFlat" class="form-check-input" id="isFlat" /><label asp-for="IsFlat" class="form-check-label">Flat Rate?</label></div>
    <div id="flatSection" class="mb-3"><label asp-for="FlatRate" class="form-label">Flat Rate (₹/L)</label><input asp-for="FlatRate" type="number" step="0.01" class="form-control" /></div>
    <div id="fatSection">
        <div class="row g-2 mb-3">
            <div class="col-4"><label asp-for="MinFat" class="form-label">Min Fat%</label><input asp-for="MinFat" type="number" step="0.1" class="form-control" /></div>
            <div class="col-4"><label asp-for="MaxFat" class="form-label">Max Fat%</label><input asp-for="MaxFat" type="number" step="0.1" class="form-control" /></div>
            <div class="col-4"><label asp-for="Rate" class="form-label">Rate (₹/L)</label><input asp-for="Rate" type="number" step="0.01" class="form-control" /></div>
        </div>
    </div>
    <div class="mb-3"><label asp-for="EffectiveFrom" class="form-label"></label><input asp-for="EffectiveFrom" type="datetime-local" class="form-control" /></div>
    <div class="mb-3"><label asp-for="EffectiveTo" class="form-label"></label><input asp-for="EffectiveTo" type="datetime-local" class="form-control" /></div>
    <button type="submit" class="btn btn-success">Save</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
</form>
</div></div>
<script>
function toggleSections() {
    var flat = document.getElementById('isFlat').checked;
    document.getElementById('flatSection').style.display = flat ? '' : 'none';
    document.getElementById('fatSection').style.display = flat ? 'none' : '';
}
document.getElementById('isFlat').addEventListener('change', toggleSections);
toggleSections();
</script>
