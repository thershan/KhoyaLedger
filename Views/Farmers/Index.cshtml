@model List<KhoyaLedger.Models.Farmer>
@{ViewData["Title"] = "Farmers";}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>👨‍🌾 Farmers</h2>
    @if (User.IsInRole("Owner")) { <a asp-action="Create" class="btn btn-success">➕ Add Farmer</a> }
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto"><input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search code/name/village..." /></div>
    <div class="col-auto"><button type="submit" class="btn btn-primary">Search</button></div>
</form>

<div class="table-responsive">
<table class="table table-hover table-sm">
    <thead class="table-dark"><tr><th>Code</th><th>Name</th><th>Village</th><th>Mobile</th><th>Type</th><th>Advance Bal</th><th>Milk Payable</th><th>Actions</th></tr></thead>
    <tbody>
    @foreach (var f in Model)
    {
        <tr class="@(f.IsActive ? "" : "table-secondary")">
            <td>@f.FarmerCode</td>
            <td>@f.Name</td>
            <td>@f.Village</td>
            <td>@f.Mobile</td>
            <td><span class="badge @(f.MilkType == KhoyaLedger.Models.MilkType.Buffalo ? "bg-info text-dark" : "bg-warning text-dark")">@f.MilkType</span></td>
            <td class="text-danger fw-bold">₹@f.AdvanceBalance.ToString("N2")</td>
            <td class="text-success fw-bold">₹@f.MilkPayable.ToString("N2")</td>
            <td>
                <a asp-action="Statement" asp-route-id="@f.Id" class="btn btn-sm btn-outline-primary">Statement</a>
                @if (User.IsInRole("Owner")) {
                    <a asp-action="Edit" asp-route-id="@f.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <a asp-action="OpeningBalance" asp-route-id="@f.Id" class="btn btn-sm btn-outline-warning">Balance</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
