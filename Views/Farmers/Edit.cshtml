@model KhoyaLedger.Models.Farmer
@{ViewData["Title"] = "Edit Farmer";}
<h2>Edit Farmer</h2>
<div class="row"><div class="col-md-6">
<form asp-action="Edit" method="post">
    <input asp-for="Id" type="hidden" />
    <input asp-for="CreatedAt" type="hidden" />
    <div asp-validation-summary="All" class="alert alert-danger"></div>
    <div class="mb-3"><label asp-for="FarmerCode" class="form-label"></label><input asp-for="FarmerCode" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Village" class="form-label"></label><input asp-for="Village" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Mobile" class="form-label"></label><input asp-for="Mobile" class="form-control" /></div>
    <div class="mb-3"><label asp-for="MilkType" class="form-label"></label><select asp-for="MilkType" asp-items="Html.GetEnumSelectList<KhoyaLedger.Models.MilkType>()" class="form-select"></select></div>
    <div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Active</label></div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
</form>
</div></div>
