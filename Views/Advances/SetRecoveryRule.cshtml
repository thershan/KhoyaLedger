@model KhoyaLedger.Models.Advance
@using KhoyaLedger.Models
@{ViewData["Title"] = "Set Recovery Rule"; var farmer = ViewBag.Farmer as Farmer;}
<h2>Set Recovery Rule - @farmer?.Name</h2>
<div class="row"><div class="col-md-5">
<form asp-action="SetRecoveryRule" method="post">
    <input type="hidden" name="farmerId" value="@farmer?.Id" />
    <div class="mb-3"><label class="form-label fw-bold">Recovery Type</label>
        <select name="recoveryType" class="form-select">
            @foreach (var rt in Enum.GetValues<RecoveryType>())
            { <option value="@((int)rt)" selected="@(Model.RecoveryType == rt)">@rt</option> }
        </select>
    </div>
    <div class="mb-3"><label class="form-label">Recovery Value (₹/L or %)</label><input type="number" name="recoveryValue" step="0.01" value="@Model.RecoveryValue" class="form-control" /></div>
    <div class="mb-3"><label class="form-label">Notes</label><input type="text" name="notes" class="form-control" /></div>
    <button type="submit" class="btn btn-primary">Save Rule</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
</form>
</div></div>
