@model List<KhoyaLedger.Models.ProductionBatch>
@using KhoyaLedger.Models
@{ViewData["Title"] = "Production Batches";}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>🏭 Production Batches</h2>
    <div>
        <span class="badge bg-info text-dark fs-6 me-2">Stock: @(((decimal)ViewBag.CurrentStock).ToString("F2")) kg</span>
        <a asp-action="Create" class="btn btn-success">➕ New Batch</a>
    </div>
</div>
<div class="table-responsive">
<table class="table table-hover table-sm">
    <thead class="table-dark"><tr><th>Batch#</th><th>Date</th><th>Milk Used</th><th>Khoya Produced</th><th>Total Cost</th><th>Cost/kg</th><th>Yield%</th><th>Status</th><th>Actions</th></tr></thead>
    <tbody>
    @foreach (var b in Model)
    {
        <tr>
            <td>@b.BatchNumber</td>
            <td>@b.BatchDate</td>
            <td>@b.MilkUsedLitres.ToString("F1") L</td>
            <td class="fw-bold">@b.KhoyaProducedKg.ToString("F2") kg</td>
            <td>₹@b.TotalCostRs.ToString("N2")</td>
            <td>₹@b.CostPerKg.ToString("F2")</td>
            <td>@b.YieldPercent.ToString("F1")%</td>
            <td><span class="badge @(b.Status == BatchStatus.Posted ? "bg-success" : "bg-secondary")">@b.Status</span></td>
            <td>
                @if (b.Status == BatchStatus.Draft)
                {
                    <a asp-action="Edit" asp-route-id="@b.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <form asp-action="Post" asp-route-id="@b.Id" method="post" class="d-inline">
                        <button class="btn btn-sm btn-success">Post</button>
                    </form>
                }
                @if (b.Status == BatchStatus.Posted)
                {
                    <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#spoilageModal" data-batchid="@b.Id">Spoilage</button>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
</div>

<div class="modal fade" id="spoilageModal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <form asp-action="Spoilage" method="post">
            <div class="modal-header"><h5 class="modal-title">Record Spoilage</h5></div>
            <div class="modal-body">
                <input type="hidden" name="batchId" id="spoilageBatchId" />
                <div class="mb-3"><label class="form-label">Quantity (kg)</label><input type="number" name="kg" step="0.01" class="form-control" /></div>
                <div class="mb-3"><label class="form-label">Notes</label><input type="text" name="notes" class="form-control" /></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-danger">Record Spoilage</button>
            </div>
        </form>
    </div></div>
</div>
<script>
document.getElementById('spoilageModal')?.addEventListener('show.bs.modal', function(e) {
    document.getElementById('spoilageBatchId').value = e.relatedTarget.dataset.batchid;
});
</script>
