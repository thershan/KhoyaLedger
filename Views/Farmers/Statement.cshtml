@model List<KhoyaLedger.Models.MilkCollection>
@using KhoyaLedger.Models
@{
    ViewData["Title"] = "Farmer Statement";
    var farmer = ViewBag.Farmer as Farmer;
    var fromDate = ViewBag.FromDate as DateOnly?;
    var toDate = ViewBag.ToDate as DateOnly?;
    var advances = ViewBag.Advances as List<Advance> ?? new();
    var payments = ViewBag.Payments as List<SettlementPayment> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>📋 @farmer?.Name <small class="text-muted fs-6">(@farmer?.FarmerCode)</small></h2>
    <a asp-action="Index" class="btn btn-secondary btn-sm">← Back</a>
</div>

<div class="row g-3 mb-3">
    <div class="col-sm-4">
        <div class="card border-danger">
            <div class="card-body py-2">
                <div class="text-muted small">Advance Balance (owed by farmer)</div>
                <div class="fw-bold fs-5 text-danger">₹@farmer?.AdvanceBalance.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card border-success">
            <div class="card-body py-2">
                <div class="text-muted small">Milk Payable (owed to farmer)</div>
                <div class="fw-bold fs-5 text-success">₹@farmer?.MilkPayable.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card border-info">
            <div class="card-body py-2">
                <div class="text-muted small">Village</div>
                <div class="fw-bold">@farmer?.Village | @farmer?.MilkType</div>
            </div>
        </div>
    </div>
</div>

<form method="get" class="row g-2 mb-3">
    <input type="hidden" name="id" value="@farmer?.Id" />
    <div class="col-auto"><input type="date" name="fromDate" class="form-control" value="@fromDate?.ToString("yyyy-MM-dd")" /></div>
    <div class="col-auto"><input type="date" name="toDate" class="form-control" value="@toDate?.ToString("yyyy-MM-dd")" /></div>
    <div class="col-auto"><button type="submit" class="btn btn-primary">Filter</button></div>
    <div class="col-auto">
        <a asp-action="OpeningBalance" asp-route-id="@farmer?.Id" class="btn btn-outline-secondary">Set Opening Balance</a>
    </div>
</form>

<div class="table-responsive">
<table class="table table-sm table-hover">
    <thead class="table-dark">
        <tr><th>Date</th><th>Shift</th><th>Litres</th><th>Fat%</th><th>Rate</th><th>Gross Value</th><th>Receipt</th></tr>
    </thead>
    <tbody>
    @{decimal totalLitres = 0; decimal totalGross = 0;}
    @foreach (var c in Model)
    {
        totalLitres += c.Litres;
        totalGross += c.GrossMilkValue;
        <tr>
            <td>@c.CollectionDate</td>
            <td>@c.Shift</td>
            <td>@c.Litres.ToString("F1")</td>
            <td>@c.Fat.ToString("F1")</td>
            <td>₹@c.AppliedRate.ToString("F2")</td>
            <td class="fw-bold">₹@c.GrossMilkValue.ToString("N2")</td>
            <td><small>@c.ReceiptNumber</small></td>
        </tr>
    }
    </tbody>
    <tfoot class="table-active">
        <tr><th colspan="2">Total</th><th>@totalLitres.ToString("F1") L</th><th></th><th></th><th class="fw-bold">₹@totalGross.ToString("N2")</th><th></th></tr>
    </tfoot>
</table>
</div>

@if (advances.Any())
{
    <h5 class="mt-3">Advances</h5>
    <table class="table table-sm">
        <thead><tr><th>Date</th><th>Type</th><th>Amount</th><th>Notes</th></tr></thead>
        <tbody>
        @foreach (var a in advances)
        {
            <tr>
                <td>@a.TransactionDate</td>
                <td>@a.Type</td>
                <td>₹@a.Amount.ToString("N2")</td>
                <td>@a.Notes</td>
            </tr>
        }
        </tbody>
    </table>
}

@if (payments.Any())
{
    <h5 class="mt-3">Settlement Payments</h5>
    <table class="table table-sm">
        <thead><tr><th>Date</th><th>Amount</th><th>Mode</th><th>Notes</th></tr></thead>
        <tbody>
        @foreach (var p in payments)
        {
            <tr>
                <td>@p.PaidDate</td>
                <td class="fw-bold text-success">₹@p.Amount.ToString("N2")</td>
                <td>@p.PaymentMode</td>
                <td>@p.Notes</td>
            </tr>
        }
        </tbody>
    </table>
}
